# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL via docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_intel?schema=public

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# AI enrichment (Anthropic) — server-side only, never exposed to the client.
# Leave ANTHROPIC_API_KEY blank to fall back to deterministic heuristics.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# News provider — server-side only. Leave NEWS_API_KEY blank to disable
# headline fetching (no-op fallback).
NEWS_API_KEY=
NEWS_API_URL=https://newsapi.org/v2/everything

# Cache TTL (hours) for enrichment results stored in the Enrichment table.
ENRICHMENT_TTL_HOURS=24
